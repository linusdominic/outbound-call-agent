# Needed for `callagent serve` and `callagent simulate`. Everything else runs without it.
ANTHROPIC_API_KEY=

# Optional. The model that plays the agent.
# CALLAGENT_MODEL=claude-haiku-5-5

# Optional. The most the demo page may spend, in dollars. It keeps its own ledger.
# CALLAGENT_APP_BUDGET=1.0

# --- For connecting a voice platform (see docs/integrations) ---

# The shared secret every /v1 request must send. Set it before the server is reachable
# from the internet.
# CALLAGENT_API_KEY=

# A SQLite file for the do-not-call list, attempts, calendar and callbacks.
# CALLAGENT_DB=records.db

# A CSV lead list with the columns of data/leads.csv, so requests can name a lead_id.
# CALLAGENT_LEADS=data/leads.csv

# The number a call is transferred to when the contact asks for a person.
# CALLAGENT_TRANSFER_NUMBER=+15550100

# For the generic OpenAI-compatible endpoint: the platform's hang-up and transfer tools.
# CALLAGENT_END_TOOL=end_call
# CALLAGENT_TRANSFER_TOOL=transfer_call
# CALLAGENT_TRANSFER_ARGS={"destination": "{transfer_number}"}

# For Vapi: set to 1 to send the older "function_call" shape in place of "tool_calls", if
# hang-ups or transfers do not trigger (see docs/integrations/vapi.md). Off unless set to 1.
# CALLAGENT_VAPI_FUNCTION_CALL=0
